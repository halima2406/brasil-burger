<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Brasil Burger - Admin{% endblock %}</title>
    
  
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
   
    <link rel="stylesheet" href="{{ asset('css/admin-base.css') }}">
    
   
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <aside class="sidebar">
        <a href="{{ path('app_dashboard') }}" class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <i class="fas fa-hamburger"></i>
            </div>
            <span class="sidebar-logo-text">Brasil Burger</span>
        </a>

        <ul class="sidebar-menu">
            <li class="sidebar-menu-title">Menu Principal</li>
            <li class="sidebar-item">
                <a href="{{ path('app_dashboard') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-th-large"></i>
                    Dashboard
                </a>
            </li>
            <li class="sidebar-item">
                <a href="{{ path('app_burger_list') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_burger' ? 'active' : '' }}">
                    <i class="fas fa-hamburger"></i>
                    Burgers
                </a>
            </li>
            <li class="sidebar-item">
                <a href="{{ path('app_menu_list') }}" class="sidebar-link {% if app.request.get('_route') starts with 'app_menu' %}active{% endif %}">
                    <i class="fas fa-layer-group"></i>
                    Menus
                </a>
            </li>
            <li class="sidebar-item">
                <a href="{{ path('app_complement_list') }}" class="sidebar-link {% if app.request.get('_route') starts with 'app_complement' %}active{% endif %}">
                    <i class="fas fa-plus-circle"></i>
                    Compléments
                </a>
            </li>

            <li class="sidebar-menu-title">Commandes</li>
            <li class="sidebar-item">
                <a href="{{ path('app_commande_list') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_commande' ? 'active' : '' }}">
                    <i class="fas fa-receipt"></i>
                    Commandes
                    <span class="sidebar-badge">{{ stats.pending ?? 12 }}</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="{{ path('app_livraison_list') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_livraison' ? 'active' : '' }}">
                    <i class="fas fa-motorcycle"></i>
                    Livraisons
                </a>
            </li>

            <li class="sidebar-menu-title">Rapports</li>
            <li class="sidebar-item">
                <a href="{{ path('app_statistiques') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_statistiques' ? 'active' : '' }}">
                    <i class="fas fa-chart-bar"></i>
                    Statistiques
                </a>
            </li>

            <li class="sidebar-menu-title">Compte</li>
            <li class="sidebar-item">
                <a href="{{ path('app_admin_logout') }}" class="sidebar-link">
                    <i class="fas fa-sign-out-alt"></i>
                    Déconnexion
                </a>
            </li>
        </ul>

        <div class="user-info">
            <div class="user-avatar">AD</div>
            <div class="user-name">Amidou Diallo</div>
            <div class="user-status">
                <i class="fas fa-circle"></i> En ligne
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="header">
            <div class="header-title">
                <h1>{% block page_title %}Dashboard{% endblock %}</h1>
                <p>{% block page_subtitle %}{% endblock %}</p>
            </div>
            <div class="header-actions">
                {% block header_actions %}{% endblock %}
                
                <div class="header-user">
                    <div class="header-user-avatar">AD</div>
                    <div class="header-user-info">
                        <div class="user-name">Amidou Diallo</div>
                        <div class="user-role">Gestionnaire</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="content">
            {% block body %}{% endblock %}
        </div>
    </main>

    {% block javascripts %}
    <script>
        // Marquer l'élément de navigation actif
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.sidebar-link');
            
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    {% endblock %}
</body>
</html>