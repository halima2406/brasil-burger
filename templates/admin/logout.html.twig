{% extends 'admin/base.html.twig' %}

{% block title %}Déconnexion - Brasil Burger{% endblock %}

{% block page_title %}Déconnexion{% endblock %}
{% block page_subtitle %}Session terminée{% endblock %}

{% block content %}
<div style="display: flex; justify-content: center; align-items: center; min-height: 60vh;">
    <div style="background: white; border-radius: 16px; padding: 40px; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
        <div style="margin-bottom: 30px;">
            <i class="fas fa-sign-out-alt" style="font-size: 64px; color: #2e7d32;"></i>
        </div>
        <h2 style="margin: 0 0 10px 0; color: #333;">Déconnexion réussie</h2>
        <p style="color: #666; margin: 0 0 30px 0;">Vous avez été déconnecté avec succès de Brasil Burger Admin</p>
        
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <a href="{{ path('app_dashboard') }}" style="display: inline-block; padding: 12px 24px; background: #2e7d32; color: white; text-decoration: none; border-radius: 8px; transition: background 0.3s;">
                <i class="fas fa-home"></i> Retour au Dashboard
            </a>
            
            <a href="{{ path('app_home') }}" style="display: inline-block; padding: 12px 24px; background: #f9a825; color: white; text-decoration: none; border-radius: 8px; transition: background 0.3s;">
                <i class="fas fa-arrow-left"></i> Accueil
            </a>
        </div>
        
        <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
            <p style="font-size: 14px; color: #999; margin: 0;">
                <i class="fas fa-info-circle"></i> 
                Session fermée le {{ "now"|date("d/m/Y à H:i") }}
            </p>
        </div>
    </div>
</div>

<style>
a:hover {
    opacity: 0.9;
    transform: translateY(-1px);
}
</style>
{% endblock %}
