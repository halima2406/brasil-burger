{% extends 'admin/base.html.twig' %}

{% block page_title %}Gestion des Burgers{% endblock %}
{% block page_subtitle %}Gérez votre catalogue de burgers{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/burger.css') }}">
{% endblock %}

{% block body %}
    <div class="filters-bar">
        <form method="GET" action="{{ path('app_burger_list') }}" class="search-form">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" 
                       name="search" 
                       value="{{ search|default('') }}" 
                       placeholder="Rechercher un burger..." 
                       class="form-control">
            </div>
            <button type="submit" class="btn btn-primary">Rechercher</button>
            {% if search %}
                <a href="{{ path('app_burger_list') }}" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Effacer
                </a>
            {% endif %}
        </form>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Burger</th>
                    <th>Prix</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if burgers is empty %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 40px;">
                            <div style="color: #666;">
                                <i class="fas fa-hamburger fa-3x"></i>
                                <h4>Aucun burger trouvé</h4>
                                {% if search %}
                                    <p>Aucun résultat pour "{{ search }}"</p>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for burger in burgers %}
                    <tr>
                        <td>
                            <div class="product-cell">
                                <div class="product-image">
                                    <i class="fas fa-hamburger"></i>
                                </div>
                                <div class="product-info">
                                    <h4>{{ burger.nom }}</h4>
                                    <p>{{ burger.description|default('Burger savoureux avec ingrédients frais') }}</p>
                                </div>
                            </div>
                        </td>
                        <td><span class="price">{{ burger.prix_formate }} FCFA</span></td>
                        <td>
                            <span class="status-badge {{ burger.disponible ? 'active' : 'inactive' }}">
                                {{ burger.statut }}
                            </span>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <button class="action-btn" title="Modifier" onclick="editerBurger({{ burger.id }}, '{{ burger.nom|e('js') }}', {{ burger.prix }})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-btn" title="Voir détails" onclick="voirDetailsBurger({{ burger.id }})">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn delete" title="Supprimer" onclick="supprimerBurger({{ burger.id }}, '{{ burger.nom|e('js') }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    {% if pagination.total_pages > 1 %}
    <div class="pagination-container">
        <div class="pagination">
            {% if pagination.has_previous %}
                <a href="?page={{ pagination.previous_page }}{% if search %}&search={{ search }}{% endif %}" 
                   class="pagination-btn" title="Page précédente">
                    <i class="fas fa-chevron-left"></i>
                </a>
            {% endif %}
            
            {% for pageNum in pagination.pages %}
                {% if pageNum == pagination.current_page %}
                    <span class="pagination-btn active">{{ pageNum }}</span>
                {% else %}
                    <a href="?page={{ pageNum }}{% if search %}&search={{ search }}{% endif %}" 
                       class="pagination-btn">{{ pageNum }}</a>
                {% endif %}
            {% endfor %}
            
            {% if pagination.has_next %}
                <a href="?page={{ pagination.next_page }}{% if search %}&search={{ search }}{% endif %}" 
                   class="pagination-btn" title="Page suivante">
                    <i class="fas fa-chevron-right"></i>
                </a>
            {% endif %}
        </div>
        <p class="pagination-info">
            Page {{ pagination.current_page }} sur {{ pagination.total_pages }} 
            ({{ pagination.total_items }} éléments)
            {% if search %}- Recherche: "{{ search }}"{% endif %}
        </p>
    </div>
    {% endif %}

    <div id="modalOverlay" class="modal-overlay">
        <div class="modal-container">
            <div id="modalContent" class="modal-content"></div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        async function voirDetailsBurger(burgerId) {
            try {
                const response = await fetch(`/admin/burger/details/${burgerId}`);
                const data = await response.json();
                
                if (data.error) {
                    showNotification('❌ ' + data.error, 'error');
                    return;
                }
                
                const modalContent = `
                    <div class="modal-header">
                        <h3><i class="fas fa-hamburger"></i> ${data.burger.nom}</h3>
                        <button onclick="fermerModal()" class="close-btn">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="burger-stats">
                            <div class="stat-item">
                                <div class="stat-icon price"><i class="fas fa-tag"></i></div>
                                <div class="stat-info">
                                    <h4>${data.burger.prix_formate} FCFA</h4>
                                    <p>Prix unitaire</p>
                                </div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-icon sales"><i class="fas fa-chart-line"></i></div>
                                <div class="stat-info">
                                    <h4>${data.burger.ventes_totales}</h4>
                                    <p>Ventes totales</p>
                                </div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-icon today"><i class="fas fa-calendar-day"></i></div>
                                <div class="stat-info">
                                    <h4>${data.burger.ventes_jour}</h4>
                                    <p>Ventes aujourd'hui</p>
                                </div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-icon revenue"><i class="fas fa-coins"></i></div>
                                <div class="stat-info">
                                    <h4>${data.burger.chiffre_affaires_formate} FCFA</h4>
                                    <p>Chiffre d'affaires</p>
                                </div>
                            </div>
                        </div>
                        
                        ${data.commandes.length > 0 ? `
                        <div class="recent-orders">
                            <h4><i class="fas fa-history"></i> Commandes récentes</h4>
                            <div class="orders-list">
                                ${data.commandes.slice(0, 5).map(cmd => `
                                    <div class="order-item">
                                        <div class="order-date">${cmd.date_formate}</div>
                                        <div class="order-quantity">${cmd.quantite}x</div>
                                        <div class="order-total">${cmd.total_formate} FCFA</div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        ` : `
                        <div class="no-orders">
                            <i class="fas fa-inbox fa-2x"></i>
                            <p>Aucune commande encore</p>
                        </div>
                        `}
                    </div>
                `;
                
                document.getElementById('modalContent').innerHTML = modalContent;
                document.getElementById('modalOverlay').classList.add('active');
                
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('❌ Erreur lors du chargement', 'error');
            }
        }

        async function editerBurger(burgerId, nomActuel, prixActuel) {
            const modalContent = `
                <div class="modal-header">
                    <h3><i class="fas fa-edit"></i> Modifier le burger</h3>
                    <button onclick="fermerModal()" class="close-btn">&times;</button>
                </div>
                <div class="modal-body">
                    <form onsubmit="sauvegarderBurger(event, ${burgerId})">
                        <div class="form-group">
                            <label>Nom du burger</label>
                            <input type="text" id="burgerNom" value="${nomActuel}" required>
                        </div>
                        <div class="form-group">
                            <label>Prix (FCFA)</label>
                            <input type="number" id="burgerPrix" value="${prixActuel}" min="0" required>
                        </div>
                        <div class="form-actions">
                            <button type="button" onclick="fermerModal()" class="btn-cancel">Annuler</button>
                            <button type="submit" class="btn-save">Sauvegarder</button>
                        </div>
                    </form>
                </div>
            `;
            
            document.getElementById('modalContent').innerHTML = modalContent;
            document.getElementById('modalOverlay').classList.add('active');
        }

        async function sauvegarderBurger(event, burgerId) {
            event.preventDefault();
            
            const nom = document.getElementById('burgerNom').value;
            const prix = document.getElementById('burgerPrix').value;
            
            try {
                const formData = new FormData();
                formData.append('nom', nom);
                formData.append('prix', prix);
                
                const response = await fetch(`/admin/burger/edit/${burgerId}`, {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showNotification('✅ ' + data.message, 'success');
                    fermerModal();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showNotification('❌ ' + data.error, 'error');
                }
                
            } catch (error) {
                showNotification('❌ Erreur lors de la modification', 'error');
            }
        }

        async function supprimerBurger(burgerId, nomBurger) {
            const modalContent = `
                <div class="modal-header danger">
                    <h3><i class="fas fa-exclamation-triangle"></i> Supprimer le burger</h3>
                    <button onclick="fermerModal()" class="close-btn">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="warning-content">
                        <i class="fas fa-trash-alt fa-3x"></i>
                        <h4>Êtes-vous sûr ?</h4>
                        <p>Vous êtes sur le point de supprimer <strong>"${nomBurger}"</strong>.</p>
                        <p class="warning-text">Cette action est irréversible !</p>
                    </div>
                    <div class="form-actions">
                        <button type="button" onclick="fermerModal()" class="btn-cancel">Annuler</button>
                        <button type="button" onclick="confirmerSuppression(${burgerId})" class="btn-delete">Supprimer</button>
                    </div>
                </div>
            `;
            
            document.getElementById('modalContent').innerHTML = modalContent;
            document.getElementById('modalOverlay').classList.add('active');
        }

        async function confirmerSuppression(burgerId) {
            try {
                const response = await fetch(`/admin/burger/delete/${burgerId}`, {
                    method: 'POST'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showNotification('✅ ' + data.message, 'success');
                    fermerModal();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showNotification('❌ ' + data.error, 'error');
                }
                
            } catch (error) {
                showNotification('❌ Erreur lors de la suppression', 'error');
            }
        }

        function fermerModal() {
            document.getElementById('modalOverlay').classList.remove('active');
        }

        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => notification.classList.add('show'), 100);
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        document.addEventListener('click', function(e) {
            if (e.target.id === 'modalOverlay') {
                fermerModal();
            }
        });
    </script>
{% endblock %}