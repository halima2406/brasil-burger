{% extends 'admin/base.html.twig' %}

{% block page_title %}Gestion des Burgers{% endblock %}
{% block page_subtitle %}Gérez votre catalogue de burgers{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/burger.css') }}">
{% endblock %}

{% block body %}
    <div class="filters-bar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Rechercher un burger..." class="form-control">
        </div>
        <button class="btn btn-primary">Rechercher</button>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Burger</th>
                    <th>Prix</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if burgers is empty %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 40px;">
                            <div style="color: #666;">
                                <i class="fas fa-hamburger fa-3x"></i>
                                <h4>Aucun burger trouvé</h4>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for burger in burgers %}
                    <tr>
                        <td>
                            <div class="product-cell">
                                <div class="product-image">
                                    <i class="fas fa-hamburger"></i>
                                </div>
                                <div class="product-info">
                                    <h4>{{ burger.nom }}</h4>
                                    <p>Burger savoureux Brasil Burger</p>
                                </div>
                            </div>
                        </td>
                        <td><span class="price">{{ burger.prix_formate }} FCFA</span></td>
                        <td>
                            <span class="status-badge {{ burger.disponible ? 'active' : 'inactive' }}">
                                {{ burger.statut }}
                            </span>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <button class="action-btn" title="Modifier" onclick="editerBurger({{ burger.id }}, '{{ burger.nom }}', {{ burger.prix }})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-btn" title="Voir détails" onclick="voirDetails({{ burger.id }})">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn delete" title="Supprimer" onclick="supprimerBurger({{ burger.id }}, '{{ burger.nom }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function voirDetails(id) {
            alert('Détails burger ' + id);
        }

        function editerBurger(id, nom, prix) {
            const nouveauNom = prompt('Nouveau nom:', nom);
            const nouveauPrix = prompt('Nouveau prix:', prix);
            
            if (nouveauNom && nouveauPrix) {
                // Logique d'édition à implémenter
                alert('Modification burger ' + id);
            }
        }

        function supprimerBurger(id, nom) {
            if (confirm('Supprimer ' + nom + ' ?')) {
                // Logique de suppression à implémenter
                alert('Suppression burger ' + id);
            }
        }
    </script>
{% endblock %}