{% extends 'admin/base.html.twig' %}

{% block title %}Menus - Brasil Burger{% endblock %}
{% block page_title %}Gestion des Menus{% endblock %}
{% block page_subtitle %}Gérez vos formules et menus complets{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menu.css') }}">
{% endblock %}

{% block body %}
<div class="menu-management">
    <div class="menu-header">
        <div class="search-section">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Rechercher un menu..." id="menuSearch">
            </div>
        </div>
        
        <div class="header-actions">
            <div class="filter-group">
                <button class="filter-btn active">Tous les statuts</button>
                <button class="filter-btn">Trier par</button>
            </div>
            <button class="btn-add-menu">
                <i class="fas fa-plus"></i>
                Ajouter un menu
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="menu-table">
            <thead>
                <tr>
                    <th class="col-menu">MENU</th>
                    <th class="col-composition">COMPOSITION</th>
                    <th class="col-prix">PRIX</th>
                    <th class="col-statut">STATUT</th>
                    <th class="col-actions">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% if menus is empty %}
                    <tr>
                        <td colspan="5" class="empty-state">
                            <div class="empty-content">
                                <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                                <h4>Aucun menu trouvé</h4>
                                <p class="text-muted">Les menus seront affichés ici une fois créés</p>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for menu in menus %}
                    <tr class="menu-row">
                        <td class="menu-info">
                            <div class="menu-item-wrapper">
                                <div class="menu-image">
                                    <img src="https://images.unsplash.com/photo-1586190848861-99aa4a171e90?w=200&h=200&fit=crop" alt="{{ menu.nom }}">
                                </div>
                                <div class="menu-details">
                                    <h4 class="menu-name">{{ menu.nom }}</h4>
                                    <p class="menu-description">{{ menu.description|default('Menu signature Brasil Burger') }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="composition">
                            <div class="composition-items">
                                {% if menu.burger_nom %}
                                    <span class="comp-item comp-burger">
                                        <i class="fas fa-hamburger"></i> {{ menu.burger_nom }}
                                    </span>
                                {% endif %}
                                {% if menu.frite_nom %}
                                    <span class="comp-item comp-frites">
                                        <i class="fas fa-circle"></i> {{ menu.frite_nom }}
                                    </span>
                                {% endif %}
                                {% if menu.boisson_nom %}
                                    <span class="comp-item comp-boisson">
                                        <i class="fas fa-circle"></i> {{ menu.boisson_nom }}
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="prix">
                            <div class="prix-info">
                                <span class="prix-principal">{{ menu.prix_formate }}</span>
                            </div>
                        </td>
                        <td class="statut">
                            <span class="statut-badge {{ menu.est_archive ? 'archive' : 'actif' }}">
                                {{ menu.est_archive ? 'Archivé' : 'Actif' }}
                            </span>
                        </td>
                        <td class="actions">
                            <div class="action-buttons">
                                <button class="action-btn view" title="Voir détails" onclick="voirDetailsMenu({{ menu.id }})">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn edit" title="Archiver/Activer" onclick="toggleStatutMenu({{ menu.id }}, '{{ menu.nom|e('js') }}')">
                                    <i class="fas fa-archive"></i>
                                </button>
                                <button class="action-btn delete" title="Supprimer" onclick="supprimerMenu({{ menu.id }}, '{{ menu.nom|e('js') }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<div id="modalOverlay" class="modal-overlay">
    <div class="modal-container">
        <div id="modalContent" class="modal-content">
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function voirDetailsMenu(id) {
            alert('Détails menu ' + id);
        }

        function toggleStatutMenu(id, nom) {
            if (confirm('Changer le statut de ' + nom + ' ?')) {
                alert('Toggle menu ' + id);
            }
        }

        function supprimerMenu(id, nom) {
            if (confirm('Supprimer ' + nom + ' ?')) {
                alert('Suppression menu ' + id);
            }
        }
    </script>
{% endblock %}