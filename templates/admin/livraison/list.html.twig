{% extends 'admin/base.html.twig' %}

{% block title %}Livraisons - Brasil Burger{% endblock %}
{% block page_title %}Gestion des Livraisons{% endblock %}
{% block page_subtitle %}Assignation et suivi des livraisons en temps réel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/livraison.css') }}">
{% endblock %}

{% block body %}
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h4>{{ stats.en_attente|default(0) }}</h4>
                <p>En attente</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon delivering">
                <i class="fas fa-motorcycle"></i>
            </div>
            <div class="stat-info">
                <h4>{{ stats.en_cours|default(0) }}</h4>
                <p>En cours</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon completed">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h4>{{ stats.livrees_aujourd_hui|default(0) }}</h4>
                <p>Livrées aujourd'hui</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon revenue">
                <i class="fas fa-euro-sign"></i>
            </div>
            <div class="stat-info">
                <h4>{{ stats.ca_livraisons_jour|default('0 FCFA') }}</h4>
                <p>CA Livraisons</p>
            </div>
        </div>
    </div>

    <div class="livreurs-section">
        <div class="section-header">
            <h2>Livreurs disponibles</h2>
            <a href="{{ path('app_livraison_assignation') }}" class="btn-assignation">
                <i class="fas fa-plus"></i>
                Assigner des commandes
            </a>
        </div>
        
        <div class="livreurs-grid">
            {% if livreurs is defined and livreurs|length > 0 %}
                {% for livreur in livreurs %}
                <div class="livreur-card" onclick="selectLivreur(this)" data-livreur-id="{{ livreur.id }}">
                    <div class="livreur-avatar">
                        {{ livreur.nom|slice(0, 2)|upper }}
                    </div>
                    <div class="livreur-info">
                        <h4>{{ livreur.nom }}</h4>
                        <p>
                            <i class="fas fa-star"></i> 
                            4.{{ random(6, 9) }} · {{ random(50, 200) }} livraisons
                        </p>
                    </div>
                    <div class="livreur-status">
                        <span class="status-dot {{ loop.index <= 2 ? 'active' : 'busy' }}"></span>
                        <span class="status-text">
                            {% if loop.index <= 2 %}
                                {{ random(0, 2) }} en cours
                            {% else %}
                                Occupé
                            {% endif %}
                        </span>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="livreur-card" data-livreur-id="1">
                    <div class="livreur-avatar">MD</div>
                    <div class="livreur-info">
                        <h4>Moussa Diop</h4>
                        <p><i class="fas fa-star"></i> 4.8 · 156 livraisons</p>
                    </div>
                    <div class="livreur-status">
                        <span class="status-dot active"></span>
                        <span class="status-text">0 en cours</span>
                    </div>
                </div>
                
                <div class="livreur-card" data-livreur-id="2">
                    <div class="livreur-avatar">IF</div>
                    <div class="livreur-info">
                        <h4>Ibrahima Fall</h4>
                        <p><i class="fas fa-star"></i> 4.9 · 203 livraisons</p>
                    </div>
                    <div class="livreur-status">
                        <span class="status-dot active"></span>
                        <span class="status-text">1 en cours</span>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="commandes-section">
        <div class="section-header">
            <h2>Commandes à affecter</h2>
            <div class="zone-filters">
                <button class="zone-btn active" onclick="filterZone('all')">
                    Toutes <span class="count">{{ commandesEnAttente|length }}</span>
                </button>
                {% if zones is defined %}
                    {% for zone in zones %}
                        {% set count = 0 %}
                        {% for commande in commandesEnAttente %}
                            {% if commande.zone_id == zone.id %}
                                {% set count = count + 1 %}
                            {% endif %}
                        {% endfor %}
                        {% if count > 0 %}
                        <button class="zone-btn" onclick="filterZone('{{ zone.id }}')">
                            {{ zone.quartier }} <span class="count">{{ count }}</span>
                        </button>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <div class="commandes-container">
            {% if commandesEnAttente is empty %}
                <div class="empty-state">
                    <i class="fas fa-check-circle"></i>
                    <h3>Toutes les commandes sont assignées !</h3>
                    <p>Aucune commande en attente d'assignation.</p>
                </div>
            {% else %}
                {% for commande in commandesEnAttente %}
                <div class="commande-card" data-zone="{{ commande.zone_id|default('') }}" data-commande-id="{{ commande.id }}">
                    <div class="commande-header">
                        <span class="numero">#CMD{{ commande.numero_commande }}</span>
                        <span class="date">{{ commande.date_formate }}</span>
                        <span class="priorite {{ commande.priorite|default('normale') }}">
                            {% if commande.priorite|default('normale') == 'urgent' %}
                                <i class="fas fa-exclamation-triangle"></i> URGENT
                            {% elseif commande.priorite|default('normale') == 'normale' %}
                                <i class="fas fa-clock"></i> NORMALE
                            {% else %}
                                <i class="fas fa-check"></i> RÉCENTE
                            {% endif %}
                        </span>
                    </div>
                    
                    <div class="commande-client">
                        <h4>{{ commande.client_nom }}</h4>
                        <p>{{ commande.telephone_client }}</p>
                    </div>
                    
                    <div class="commande-adresse">
                        <i class="fas fa-map-marker-alt"></i>
                        {{ commande.adresse_livraison }}
                    </div>
                    
                    <div class="commande-footer">
                        <div class="zone-badge">{{ commande.quartier }}</div>
                        <div class="prix-info">
                            <span class="prix-principal">{{ commande.total_formate }}</span>
                            <span class="prix-livraison">+ {{ commande.prix_livraison_formate }}</span>
                        </div>
                    </div>
                    
                    <div class="commande-actions">
                        <button class="btn-details" onclick="voirDetails({{ commande.id }})">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn-assign" onclick="showAssignModal({{ commande.id }})">
                            <i class="fas fa-motorcycle"></i>
                            Assigner
                        </button>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if livraisonsEnCours is defined and livraisonsEnCours|length > 0 %}
    <div class="livraisons-section">
        <div class="section-header">
            <h2>Livraisons en cours</h2>
           <a href="{{ path('app_livraison_suivi') }}" class="btn-suivi">
                <i class="fas fa-map"></i>
                Suivi complet
            </a>
        </div>
        
        <div class="livraisons-grid">
            {% for livraison in livraisonsEnCours %}
            <div class="livraison-card">
                <div class="livraison-header">
                    <span class="numero">#CMD{{ livraison.numero_commande }}</span>
                    <span class="statut {{ livraison.statut_couleur|default('info') }}">
                        <i class="fas fa-motorcycle"></i>
                        ASSIGNEE
                    </span>
                </div>
                
                <div class="livraison-livreur">
                    <div class="livreur-mini">{{ livraison.livreur_nom|slice(0, 2)|upper }}</div>
                    <div>
                        <strong>{{ livraison.livreur_nom }}</strong>
                        <p>{{ livraison.livreur_tel|default('') }}</p>
                    </div>
                </div>
                
                <div class="livraison-info">
                    <p><strong>{{ livraison.client_nom }}</strong></p>
                    <p>{{ livraison.quartier }}</p>
                    <span class="prix">{{ livraison.total_formate }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Modal Détails -->
    <div id="modalDetails" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3 id="modalTitle">Détails de la commande</h3>
                <button class="modal-close" onclick="fermerModal()">&times;</button>
            </div>
            <div class="modal-body" id="modalContent">
                <div class="loading">Chargement...</div>
            </div>
        </div>
    </div>

    <!-- Modal Assignation -->
    <div id="modalAssign" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3 id="assignTitle">Assigner un livreur</h3>
                <button class="modal-close" onclick="fermerModalAssign()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="assign-form">
                    <label for="selectLivreur">Choisir un livreur :</label>
                    <select id="selectLivreur" class="form-control">
                        <option value="">-- Sélectionner un livreur --</option>
                        {% for livreur in livreurs %}
                            <option value="{{ livreur.id }}">{{ livreur.nom }}</option>
                        {% endfor %}
                    </select>
                    
                    <div class="modal-actions">
                        <button class="btn btn-secondary" onclick="fermerModalAssign()">Annuler</button>
                        <button class="btn btn-primary" onclick="confirmerAssignation()">
                            <i class="fas fa-check"></i> Confirmer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        let selectedLivreur = null;
        let selectedLivreurId = null;
        let currentCommandeId = null;

        function selectLivreur(card) {
            document.querySelectorAll('.livreur-card').forEach(c => {
                c.classList.remove('selected');
            });
            
            card.classList.add('selected');
            selectedLivreurId = card.dataset.livreurId;
            
            const livreurNom = card.querySelector('.livreur-info h4').textContent;
            selectedLivreur = livreurNom;
        }

        function filterZone(zoneId) {
            document.querySelectorAll('.zone-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            event.target.classList.add('active');

            document.querySelectorAll('.commande-card').forEach(card => {
                if (zoneId === 'all' || card.dataset.zone === zoneId) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function showAssignModal(commandeId) {
            currentCommandeId = commandeId;
            document.getElementById('selectLivreur').value = '';
            document.getElementById('modalAssign').classList.add('active');
        }

        async function confirmerAssignation() {
            const livreurId = document.getElementById('selectLivreur').value;
            
            if (!livreurId) {
                showNotification('Veuillez sélectionner un livreur', 'error');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('livreur_id', livreurId);

                const response = await fetch(`{{ path('app_livraison_assigner', {commandeId: 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', currentCommandeId), {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                
                if (data.success) {
                    showNotification(data.message, 'success');
                    fermerModalAssign();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification('Erreur: ' + data.error, 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur lors de l\'assignation', 'error');
            }
        }

        async function voirDetails(commandeId) {
            try {
                const modal = document.getElementById('modalDetails');
                const content = document.getElementById('modalContent');
                const title = document.getElementById('modalTitle');
                
                content.innerHTML = '<div class="loading">Chargement des détails...</div>';
                modal.classList.add('active');
                
                const response = await fetch(`{{ path('app_livraison_details', {commandeId: 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', commandeId));
                const data = await response.json();
                
                if (data.success) {
                    title.textContent = `Détails CMD${data.commande.numero_commande}`;
                    content.innerHTML = `
                        <div class="commande-details">
                            <div class="detail-section">
                                <h4>Informations client</h4>
                                <p><strong>Client:</strong> ${data.commande.client_nom}</p>
                                <p><strong>Téléphone:</strong> ${data.commande.telephone_client}</p>
                                <p><strong>Adresse:</strong> ${data.commande.adresse_livraison}</p>
                                <p><strong>Zone:</strong> ${data.commande.quartier}</p>
                            </div>
                            
                            <div class="detail-section">
                                <h4>Produits commandés</h4>
                                ${data.produits.map(p => `
                                    <div class="produit-detail">
                                        <span>${p.nom} x${p.quantite}</span>
                                        <span>${p.sous_total_formate}</span>
                                    </div>
                                `).join('')}
                            </div>
                            
                            <div class="detail-section">
                                <h4>Total</h4>
                                <p><strong>Commande:</strong> ${data.commande.total_formate}</p>
                                <p><strong>Livraison:</strong> ${data.commande.prix_livraison_formate}</p>
                                <p><strong>Total final:</strong> ${data.commande.total_final}</p>
                            </div>
                        </div>
                    `;
                } else {
                    content.innerHTML = `<div class="error">Erreur: ${data.error}</div>`;
                }
                
            } catch (error) {
                console.error('Erreur:', error);
                document.getElementById('modalContent').innerHTML = `<div class="error">Erreur de chargement</div>`;
            }
        }

        function fermerModal() {
            document.getElementById('modalDetails').classList.remove('active');
        }

        function fermerModalAssign() {
            document.getElementById('modalAssign').classList.remove('active');
            currentCommandeId = null;
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i>
                ${message}
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.classList.add('show');
            }, 100);
            
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }

        // Fermer modals en cliquant à l'extérieur
        document.getElementById('modalDetails').addEventListener('click', function(e) {
            if (e.target === this) fermerModal();
        });

        document.getElementById('modalAssign').addEventListener('click', function(e) {
            if (e.target === this) fermerModalAssign();
        });
    </script>

    <style>
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal { background: white; border-radius: 15px; width: 600px; max-height: 80vh; overflow-y: auto; box-shadow: 0 10px 50px rgba(0,0,0,0.3); }
        .modal-header { padding: 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
        .modal-title { margin: 0; font-size: 18px; font-weight: 700; color: #2e7d32; }
        .modal-close { background: none; border: none; font-size: 20px; cursor: pointer; color: #666; padding: 5px; transition: all 0.3s; }
        .modal-close:hover { color: #2e7d32; }
        .modal-body { padding: 20px; }
        .loading { text-align: center; padding: 40px; color: #666; }
        .error { text-align: center; padding: 40px; color: #dc3545; }
        .detail-section { margin-bottom: 20px; }
        .detail-section h4 { margin: 0 0 10px 0; color: #2e7d32; font-size: 16px; }
        .detail-section p { margin: 5px 0; }
        .produit-detail { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
        .assign-form { padding: 20px; }
        .assign-form label { display: block; margin-bottom: 10px; font-weight: 600; }
        .form-control { width: 100%; padding: 12px; border: 2px solid #e9ecef; border-radius: 8px; font-size: 14px; }
        .form-control:focus { outline: none; border-color: #2e7d32; }
        .modal-actions { display: flex; gap: 10px; margin-top: 20px; justify-content: flex-end; }
        .btn { padding: 10px 20px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-primary { background: #2e7d32; color: white; }
        .btn-primary:hover { background: #1b5e20; }
        .btn-secondary { background: #6c757d; color: white; }
        .btn-secondary:hover { background: #5a6268; }
        .notification { position: fixed; top: 20px; right: 20px; background: white; padding: 15px 20px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border-left: 4px solid #2e7d32; transform: translateX(100%); opacity: 0; transition: all 0.3s; z-index: 2000; }
        .notification.show { transform: translateX(0); opacity: 1; }
        .notification.error { border-left-color: #dc3545; }
        .notification i { margin-right: 8px; }
        .livreur-card.selected { border-color: #2e7d32; background: #e8f5e9; }
    </style>
{% endblock %}