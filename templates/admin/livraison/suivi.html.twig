{% extends 'admin/base.html.twig' %}

{% block title %}Suivi Livraisons - Brasil Burger{% endblock %}
{% block page_title %}Suivi Complet des Livraisons{% endblock %}
{% block page_subtitle %}Tableau de bord en temps réel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/livraison.css') }}">
{% endblock %}

{% block body %}
<div class="suivi-container">
    <!-- Header Stats -->
    <div class="suivi-header">
        <div class="stat-box">
            <div class="stat-number">{{ totalLivraisons }}</div>
            <div class="stat-label">Livraisons actives</div>
        </div>
        <div class="controls">
            <div class="zone-filter">
                <select id="zoneFilter" onchange="filterByZone(this.value)">
                    <option value="all">Toutes les zones</option>
                    {% for zone in zones %}
                        <option value="{{ zone.id }}">{{ zone.quartier }}</option>
                    {% endfor %}
                </select>
            </div>
            <button class="refresh-btn" onclick="refreshSuivi()">
                <i class="fas fa-sync"></i> Actualiser
            </button>
        </div>
    </div>

    <!-- Livraisons Grid -->
    <div class="livraisons-grid">
        {% for livraison in livraisonsEnCours %}
        <div class="livraison-card" data-zone="{{ livraison.zone_id }}" data-commande="{{ livraison.id }}">
            <!-- Card Header -->
            <div class="card-header">
                <div class="commande-info">
                    <h3>#CMD{{ livraison.numero_commande }}</h3>
                    <span class="temps-ecoule">{{ livraison.temps_ecoule }}</span>
                </div>
                <span class="statut-badge {{ livraison.statut_badge.class }}">
                    {{ livraison.statut_badge.text }}
                </span>
            </div>

            <!-- Livreur Info -->
            <div class="livreur-section">
                <div class="livreur-avatar">{{ livraison.livreur_nom|slice(0, 2)|upper }}</div>
                <div class="livreur-details">
                    <strong>{{ livraison.livreur_nom }}</strong>
                    <p>{{ livraison.livreur_tel }}</p>
                </div>
                <button class="contact-btn" onclick="contactLivreur('{{ livraison.livreur_tel }}')">
                    <i class="fas fa-phone"></i>
                </button>
            </div>

            <!-- Client & Location -->
            <div class="client-section">
                <h4>{{ livraison.client_nom }}</h4>
                <p class="adresse">
                    <i class="fas fa-map-marker-alt"></i>
                    {{ livraison.adresse_livraison }}
                </p>
                <p class="zone">{{ livraison.quartier }}</p>
            </div>

            <!-- Order Details -->
            <div class="order-details">
                <div class="price-info">
                    <span class="total">{{ livraison.total_formate }}</span>
                    <span class="livraison-fee">+ {{ livraison.prix_livraison_formate }}</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="card-actions">
                <button class="btn-action details" onclick="voirDetails({{ livraison.id }})">
                    <i class="fas fa-eye"></i> Détails
                </button>
                <button class="btn-action track" onclick="trackLivraison({{ livraison.id }})">
                    <i class="fas fa-route"></i> Localiser
                </button>
            </div>
        </div>
        {% endfor %}
    </div>

    {% if livraisonsEnCours is empty %}
    <div class="empty-state">
        <i class="fas fa-motorcycle fa-3x"></i>
        <h3>Aucune livraison en cours</h3>
        <p>Toutes les livraisons sont terminées ou en attente d'assignation.</p>
        <a href="{{ path('app_livraison_list') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Assigner des commandes
        </a>
    </div>
    {% endif %}
</div>

<!-- Modal Détails -->
<div id="modalDetails" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h3 id="modalTitle">Détails de la commande</h3>
            <button class="modal-close" onclick="fermerModal()">&times;</button>
        </div>
        <div class="modal-body" id="modalContent">
            <div class="loading">Chargement...</div>
        </div>
    </div>
</div>

<!-- Modal de localisation -->
<div id="modalTrack" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h3 id="trackTitle">Localisation Livreur</h3>
            <button class="modal-close" onclick="fermerModalTrack()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="map-placeholder">
                <i class="fas fa-map-marked-alt fa-3x"></i>
                <h4>Carte GPS</h4>
                <p>Fonctionnalité de géolocalisation disponible prochainement</p>
                <div class="mock-position">
                    <strong>Position estimée :</strong><br>
                    Dakar, Sénégal<br>
                    <small class="text-muted">Dernière mise à jour: il y a 2 minutes</small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function filterByZone(zoneId) {
    const cards = document.querySelectorAll('.livraison-card');
    cards.forEach(card => {
        if (zoneId === 'all' || card.dataset.zone === zoneId) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}

function refreshSuivi() {
    location.reload();
}

function contactLivreur(telephone) {
    if (confirm(`Appeler le livreur au ${telephone} ?`)) {
        window.location.href = `tel:${telephone}`;
    }
}

async function voirDetails(commandeId) {
    try {
        const modal = document.getElementById('modalDetails');
        const content = document.getElementById('modalContent');
        const title = document.getElementById('modalTitle');
        
        content.innerHTML = '<div class="loading">Chargement des détails...</div>';
        modal.classList.add('active');
        
        const response = await fetch(`{{ path('app_livraison_details', {commandeId: 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', commandeId));
        const data = await response.json();
        
        if (data.success) {
            title.textContent = `Détails CMD${data.commande.numero_commande}`;
            content.innerHTML = `
                <div class="commande-details">
                    <div class="detail-section">
                        <h4>Informations client</h4>
                        <p><strong>Client:</strong> ${data.commande.client_nom}</p>
                        <p><strong>Téléphone:</strong> ${data.commande.telephone_client}</p>
                        <p><strong>Adresse:</strong> ${data.commande.adresse_livraison}</p>
                        <p><strong>Zone:</strong> ${data.commande.quartier}</p>
                    </div>
                    
                    <div class="detail-section">
                        <h4>Produits commandés</h4>
                        ${data.produits.map(p => `
                            <div class="produit-detail">
                                <span>${p.nom} x${p.quantite}</span>
                                <span>${p.sous_total_formate}</span>
                            </div>
                        `).join('')}
                    </div>
                    
                    <div class="detail-section">
                        <h4>Total</h4>
                        <p><strong>Commande:</strong> ${data.commande.total_formate}</p>
                        <p><strong>Livraison:</strong> ${data.commande.prix_livraison_formate}</p>
                        <p><strong>Total final:</strong> ${data.commande.total_final}</p>
                    </div>
                </div>
            `;
        } else {
            content.innerHTML = `<div class="error">Erreur: ${data.error}</div>`;
        }
        
    } catch (error) {
        console.error('Erreur:', error);
        document.getElementById('modalContent').innerHTML = `<div class="error">Erreur de chargement</div>`;
    }
}

function fermerModal() {
    document.getElementById('modalDetails').classList.remove('active');
}

function trackLivraison(commandeId) {
    document.getElementById('trackTitle').textContent = `Localisation CMD${commandeId}`;
    document.getElementById('modalTrack').classList.add('active');
}

function fermerModalTrack() {
    document.getElementById('modalTrack').classList.remove('active');
}

// Auto-refresh every 30 seconds
setInterval(refreshSuivi, 30000);
</script>
{% endblock %}