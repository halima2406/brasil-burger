{% extends 'admin/base.html.twig' %}

{% block title %}Statistiques - Brasil Burger{% endblock %}
{% block page_title %}Statistiques du jour{% endblock %}
{% block page_subtitle %}Consultez les performances de la journée{% endblock %}


{% block body %}




    <div class="stats-grid">
        
        <!-- 1. Top des ventes -->
        <div class="stat-card">
            <div class="card-header">
                <div class="card-icon orange">
                    <i class="fas fa-trophy"></i>
                </div>
                <h3 class="card-title">Burgers & Menus les plus vendus </h3>
            </div>
            <div class="card-body">
                <ul class="top-list">
                    {% for item in topVentes %}
                    <li class="top-item">
                        <div class="top-rank {{ item.classe_rang }}">{{ item.rang }}</div>
                        <div class="top-image">
                            <img src="{{ item.image_url }}" alt="{{ item.nom }}">
                        </div>
                        <div class="top-info">
                            <p class="top-name">{{ item.nom }}</p>
                            <p class="top-sales">{{ item.total_vendu }} vendus</p>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

      
        <div class="stat-card">
            <div class="card-header">
                <div class="card-icon green">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <h3 class="card-title">Recettes </h3>
            </div>
            <div class="card-body">
                <ul class="simple-list">
                    <li class="simple-item">
                        <span class="simple-label">
                            <i class="fas fa-hamburger"></i>
                            Burgers
                        </span>
                        <span class="simple-value">{{ recettesJouralieres.burgers|number_format(0, ',', ' ') }} FCFA</span>
                    </li>
                    <li class="simple-item">
                        <span class="simple-label">
                            <i class="fas fa-layer-group"></i>
                            Menus
                        </span>
                        <span class="simple-value">{{ recettesJouralieres.menus|number_format(0, ',', ' ') }} FCFA</span>
                    </li>
                    <li class="simple-item">
                        <span class="simple-label">
                            <i class="fas fa-drumstick-bite"></i>
                            Frites
                        </span>
                        <span class="simple-value">{{ recettesJouralieres.frites|number_format(0, ',', ' ') }} FCFA</span>
                    </li>
                    <li class="simple-item">
                        <span class="simple-label">
                            <i class="fas fa-glass-water"></i>
                            Boissons
                        </span>
                        <span class="simple-value">{{ recettesJouralieres.boissons|number_format(0, ',', ' ') }} FCFA</span>
                    </li>
                </ul>
            </div>
            <div class="total-row">
                <span class="total-label">Total </span>
                <span class="total-value">{{ recettesJouralieres.total|number_format(0, ',', ' ') }} FCFA</span>
            </div>
        </div>

        <!-- 3. Commandes validées -->
        <div class="stat-card">
            <div class="card-header">
                <div class="card-icon blue">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3 class="card-title">Commandes validées </h3>
            </div>
            <div class="card-body">
                <ul class="order-list">
                    {% for commande in commandesValidees %}
                    <li class="order-item">
                        <span class="order-id">{{ commande.numero }}</span>
                        <div class="order-info">
                            <p class="order-customer">{{ commande.client_nom }}</p>
                            <p class="order-time">{{ commande.heure }}</p>
                        </div>
                        <span class="order-total">{{ commande.montant_formate }} FCFA</span>
                        <span class="order-status validated">Livrée</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="total-row">
                <span class="total-label">Total commandes validées</span>
                <span class="total-value">{{ totalVentes }}</span>
            </div>
        </div>

        <!-- 4. Commandes annulées du jour -->
        <div class="stat-card">
            <div class="card-header">
                <div class="card-icon red">
                    <i class="fas fa-times-circle"></i>
                </div>
                <h3 class="card-title">Commandes annulées</h3>
            </div>
            <div class="card-body">
                <ul class="order-list">
                    {% for commande in commandesAnnulees %}
                    <li class="order-item">
                        <span class="order-id">{{ commande.numero }}</span>
                        <div class="order-info">
                            <p class="order-customer">{{ commande.client_nom }}</p>
                            <p class="order-time">{{ commande.heure }}</p>
                        </div>
                        <span class="order-total">{{ commande.montant_formate }} FCFA</span>
                        <span class="order-status cancelled">Annulée</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="total-row">
                <span class="total-label">Total commandes annulées</span>
                <span class="total-value danger">{{ commandesAnnulees|length }}</span>
            </div>
        </div>

    </div>

    <style>
        /* Date Display */
        .date-display {
            background: var(--light-gray);
            padding: 12px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .date-display i {
            color: var(--primary);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        /* Card - Structure Correcte */
        .stat-card {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            display: block; /* Force block pour éviter tout flex sur les enfants */
        }

        /* Header - TITRE EN PREMIÈRE LIGNE COMPLÈTE */
        .card-header {
            padding: 20px 25px;
            border-bottom: 1px solid var(--light-gray);
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            box-sizing: border-box;
        }

        .card-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .card-icon.orange { background: #fff3e0; color: var(--warning); }
        .card-icon.green { background: #e8f5e9; color: var(--success); }
        .card-icon.blue { background: #e3f2fd; color: var(--blue); }
        .card-icon.red { background: #ffebee; color: var(--danger); }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--dark);
            margin: 0;
            flex: 1;
        }

        /* Body - CONTENU COMPLÈTEMENT SÉPARÉ */
        .card-body {
            padding: 20px 25px;
            width: 100%;
            box-sizing: border-box;
        }

        /* Top List */
        .top-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .top-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid var(--light-gray);
        }

        .top-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .top-item:first-child {
            padding-top: 0;
        }

        .top-rank {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
        }

        .top-rank.gold { background: #fff8e1; color: #ff8f00; }
        .top-rank.silver { background: #eceff1; color: #607d8b; }
        .top-rank.bronze { background: #efebe9; color: #8d6e63; }
        .top-rank.normal { background: var(--light-gray); color: var(--gray); }

        .top-image {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            overflow: hidden;
        }

        .top-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .top-info {
            flex: 1;
        }

        .top-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
            margin: 0 0 2px 0;
        }

        .top-sales {
            font-size: 13px;
            color: var(--gray);
            margin: 0;
        }

        /* Simple List */
        .simple-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .simple-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid var(--light-gray);
        }

        .simple-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .simple-item:first-child {
            padding-top: 0;
        }

        .simple-label {
            font-size: 14px;
            color: var(--gray);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .simple-label i {
            width: 20px;
            color: var(--primary);
        }

        .simple-value {
            font-size: 16px;
            font-weight: 700;
            color: var(--dark);
        }

        /* Order List */
        .order-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .order-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid var(--light-gray);
        }

        .order-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .order-item:first-child {
            padding-top: 0;
        }

        .order-id {
            font-weight: 700;
            color: var(--primary);
            font-size: 14px;
        }

        .order-info {
            flex: 1;
        }

        .order-customer {
            font-size: 14px;
            font-weight: 500;
            color: var(--dark);
            margin: 0 0 2px 0;
        }

        .order-time {
            font-size: 12px;
            color: var(--gray);
            margin: 0;
        }

        .order-total {
            font-size: 14px;
            font-weight: 700;
            color: var(--dark);
        }

        .order-status {
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .order-status.validated {
            background: #e8f5e9;
            color: var(--success);
        }

        .order-status.cancelled {
            background: #ffebee;
            color: var(--danger);
        }

        /* Total Row */
        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 25px;
            background: var(--light-gray);
            border-top: 1px solid #e0e0e0;
        }

        .total-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
        }

        .total-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
        }

        .total-value.danger {
            color: var(--danger);
        }

        /* Responsive */
        @media (max-width: 1100px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .card-header {
                padding: 15px 20px;
            }

            .card-body {
                padding: 15px 20px;
            }

            .total-row {
                padding: 15px 20px;
            }
        }
    </style>
{% endblock %}