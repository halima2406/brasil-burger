{% extends 'admin/base.html.twig' %}

{% block title %}Compléments - Brasil Burger{% endblock %}
{% block page_title %}Gestion des Compléments{% endblock %}
{% block page_subtitle %}Frites, boissons et accompagnements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/complement.css') }}">
{% endblock %}

{% block body %}
<div class="complement-management">
    <div class="complement-header">
        <div class="search-section">
            <form method="GET" action="{{ path('app_complement_list') }}" class="search-form">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" 
                        name="search" 
                        value="{{ search|default('') }}" 
                        placeholder="Rechercher un complément..." 
                        class="search-input">
                    <input type="hidden" name="filter" value="{{ filter }}">
                </div>
                <button type="submit" class="btn btn-primary">Rechercher</button>
                {% if search %}
                    <a href="{{ path('app_complement_list') }}?filter={{ filter }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Effacer
                    </a>
                {% endif %}
            </form>
        </div>
        
        <div class="header-actions">
            <div class="filter-group">
                <a href="?filter=tous&page=1" class="filter-btn {{ filter == 'tous' ? 'active' : '' }}">
                    Tous <span class="count">{{ stats.total_complements }}</span>
                </a>
                <a href="?filter=frites&page=1" class="filter-btn {{ filter == 'frites' ? 'active' : '' }}">
                    <i class="fas fa-utensils"></i> Frites <span class="count">{{ stats.frites }}</span>
                </a>
                <a href="?filter=boissons&page=1" class="filter-btn {{ filter == 'boissons' ? 'active' : '' }}">
                    <i class="fas fa-glass-water"></i> Boissons <span class="count">{{ stats.boissons }}</span>
                </a>
            </div>
            <button class="btn-add-complement">
                <i class="fas fa-plus"></i>
                Ajouter un complément
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="complement-table">
            <thead>
                <tr>
                    <th class="col-complement">COMPLÉMENT</th>
                    <th class="col-categorie">CATÉGORIE</th>
                    <th class="col-prix">PRIX</th>
                    <th class="col-statut">STATUT</th>
                    <th class="col-actions">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% if complements is empty %}
                    <tr>
                        <td colspan="5" class="empty-state">
                            <div class="empty-content">
                                <i class="fas fa-cookie-bite fa-3x text-muted mb-3"></i>
                                <h4>Aucun complément trouvé</h4>
                                <p class="text-muted">Les compléments seront affichés ici une fois créés</p>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for complement in complements %}
                    <tr class="complement-row">
                        <td class="complement-info">
                            <div class="complement-item-wrapper">
                                <div class="complement-image">
                                    <img src="{{ complement.image_url|default('https://images.unsplash.com/photo-1565299624946-b28f40a0ca4b?w=100&h=100&fit=crop') }}" alt="{{ complement.nom }}">
                                </div>
                                <div class="complement-details">
                                    <h4 class="complement-name">{{ complement.nom }}</h4>
                                    <p class="complement-description">{{ complement.description }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="categorie">
                            <span class="categorie-badge {{ complement.categorie|default('accompagnement') }}">
                                {% if complement.categorie == 'frite' %}
                                    <i class="fas fa-utensils"></i> FRITE
                                {% elseif complement.categorie == 'boisson' %}
                                    <i class="fas fa-glass-water"></i> BOISSON
                                {% else %}
                                    <i class="fas fa-utensils"></i> COMPLEMENT
                                {% endif %}
                            </span>
                        </td>
                        <td class="prix">
                            <div class="prix-info">
                                <span class="prix-principal">{{ complement.prix_formate }}</span>
                            </div>
                        </td>
                        <td class="statut">
                            <span class="statut-badge {{ complement.disponible ? 'actif' : 'inactif' }}">
                                {{ complement.disponible ? 'Actif' : 'Inactif' }}
                            </span>
                        </td>
                        <td class="actions">
                            <div class="action-buttons">
                                <button class="action-btn view" title="Voir détails" onclick="voirDetailsComplement({{ complement.id }})">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn edit" title="Modifier" onclick="editerComplement({{ complement.id }}, '{{ complement.nom|e('js') }}', {{ complement.prix }})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-btn delete" title="Supprimer" onclick="supprimerComplement({{ complement.id }}, '{{ complement.nom|e('js') }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>


   


    {% if pagination.total_pages > 1 %}
    <div class="pagination-container">
        <div class="pagination">
            {% if pagination.has_previous %}
                <a href="?page={{ pagination.previous_page }}&filter={{ filter }}" class="pagination-btn" title="Page précédente">
                    <i class="fas fa-chevron-left"></i>
                </a>
            {% endif %}
            
            {% for pageNum in pagination.pages %}
                {% if pageNum == pagination.current_page %}
                    <span class="pagination-btn active">{{ pageNum }}</span>
                {% else %}
                    
                    <a href="?page={{ pageNum }}&filter={{ filter }}{% if search %}&search={{ search }}{% endif %}" 
                        class="pagination-btn">{{ pageNum }}</a>
                {% endif %}
            {% endfor %}
            
            {% if pagination.has_next %}
                <a href="?page={{ pagination.next_page }}&filter={{ filter }}" class="pagination-btn" title="Page suivante">
                    <i class="fas fa-chevron-right"></i>
                </a>
            {% endif %}
        </div>
        
       
    </div>
    {% endif %}
    </div>

<div id="modalOverlay" class="modal-overlay">
    <div class="modal-container">
        <div id="modalContent" class="modal-content"></div>
    </div>
</div>


{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function voirDetailsComplement(id) {
            alert('Détails complément ' + id);
        }

        function editerComplement(id, nom, prix) {
            const nouveauNom = prompt('Nouveau nom:', nom);
            const nouveauPrix = prompt('Nouveau prix:', prix);
            
            if (nouveauNom && nouveauPrix) {
                alert('Modification complément ' + id);
            }
        }

        function supprimerComplement(id, nom) {
            if (confirm('Supprimer ' + nom + ' ?')) {
                alert('Suppression complément ' + id);
            }
        }

        document.getElementById('complementSearch').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('.complement-row');
            
            rows.forEach(row => {
                const nom = row.querySelector('.complement-name').textContent.toLowerCase();
                
                if (nom.includes(searchTerm)) {
                    row.style.display = 'table-row';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
{% endblock %}