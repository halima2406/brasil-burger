<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

   
    <nav class="navbar">
        <div class="navbar-container">
            
            <a href="/" class="navbar-logo">
                <div class="navbar-logo-icon">
                    <i class="fas fa-hamburger"></i>
                </div>
                <span class="navbar-logo-text">Brasil Burger</span>
            </a>

            <div class="navbar-menu">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    var action = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <a asp-controller="Catalogue" asp-action="Index" class="navbar-item @(controller == "Catalogue" && action == "Index" ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    Catalogue
                </a>
                <a asp-controller="Catalogue" asp-action="Menus" class="navbar-item @(action == "Menus" ? "active" : "")">
                    <i class="fas fa-layer-group"></i>
                    Menus
                </a>
                <a asp-controller="Panier" asp-action="Index" class="navbar-item @(controller == "Panier" ? "active" : "")">
                    <i class="fas fa-bag-shopping"></i>
                    Commander
                </a>
                <a asp-controller="Commande" asp-action="MesCommandes" class="navbar-item @(controller == "Commande" ? "active" : "")">
                    <i class="fas fa-clock-rotate-left"></i>
                    Mes Commandes
                </a>
            </div>

            <div class="navbar-actions">
                <a asp-controller="Panier" asp-action="Index" class="navbar-cart">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Panier</span>
                    @{
                        var panier = Context.Session.GetPanier();
                        //<span class="cart-count">@panier.NombreItems</span>
                        <span class="cart-count">@panier.NombreArticles</span>
                    }
                </a>
                @if (Context.Session.GetClientId() != null)
                {
                    <a asp-controller="Auth" asp-action="Deconnexion" class="navbar-user" title="@Context.Session.GetString("ClientNom") - Déconnexion">
                        <i class="fas fa-user"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Connexion" class="navbar-user" title="Se connecter">
                        <i class="fas fa-user"></i>
                    </a>
                }
            </div>

        </div>
    </nav>

   
    <main class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="container">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container">
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
